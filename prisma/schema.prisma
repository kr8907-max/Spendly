generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  defaultCurrency String     @default("USD") @db.Char(3)
  locale          String     @default("en-US")
  createdAt       DateTime   @default(now())
  budgets         Budget[]
  categories      Category[]
  expenses        Expense[]
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  month       Int
  year        Int
  totalBudget Decimal  @db.Decimal(18, 2)
  currency    String   @db.Char(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model Category {
  id           String    @id @default(cuid())
  userId       String
  categoryName String
  description  String?
  icon         String    @default("🏷️")
  color        String    @default("#8B5CF6")
  monthlyLimit Decimal?  @db.Decimal(18, 2)
  isCustom     Boolean   @default(true)
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([userId, categoryName])
  @@index([userId, isArchived])
}

model Expense {
  id               String    @id @default(cuid())
  userId           String
  categoryId       String?
  expenseName      String
  originalAmount   Decimal   @db.Decimal(18, 2)
  originalCurrency String    @db.Char(3)
  exchangeRate     Decimal   @db.Decimal(18, 8)
  convertedAmount  Decimal   @db.Decimal(18, 2)
  budgetCurrency   String    @db.Char(3)
  expenseDate      DateTime  @db.Date
  expenseTime      String?
  paymentMethod    String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, expenseDate])
  @@index([userId, categoryId])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  baseCurrency   String   @db.Char(3)
  targetCurrency String   @db.Char(3)
  rate           Decimal  @db.Decimal(18, 8)
  fetchedAt      DateTime @default(now())

  @@index([baseCurrency, targetCurrency, fetchedAt])
}